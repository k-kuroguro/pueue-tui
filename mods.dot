digraph {

    graph [
        label="pueue_tui",
        labelloc=t,

        pad=0.4,

        // Consider rendering the graph using a different layout algorithm, such as:
        // [dot, neato, twopi, circo, fdp, sfdp]
        layout=neato,
        overlap=false,
        splines="line",
        rankdir=LR,

        fontname="Helvetica", 
        fontsize="36",
    ];

    node [
        fontname="monospace",
        fontsize="10",
        shape="record",
        style="filled",
    ];

    edge [
        fontname="monospace",
        fontsize="10",
    ];

    "pueue_tui" [label="crate|pueue_tui", fillcolor="#5397c8"]; // "crate" node
    "pueue_tui::app" [label="pub(crate) mod|app", fillcolor="#f8c04c"]; // "mod" node
    "pueue_tui::cli" [label="pub(crate) mod|cli", fillcolor="#f8c04c"]; // "mod" node
    "pueue_tui::event" [label="pub(crate) mod|event", fillcolor="#f8c04c"]; // "mod" node
    "pueue_tui::terminal" [label="pub(crate) mod|terminal", fillcolor="#f8c04c"]; // "mod" node
    "pueue_tui::ui" [label="pub(crate) mod|ui", fillcolor="#f8c04c"]; // "mod" node

    "pueue_tui" -> "pueue_tui::app" [label="owns", color="#000000", style="solid"] [constraint=true]; // "owns" edge
    "pueue_tui" -> "pueue_tui::app" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "pueue_tui" -> "pueue_tui::cli" [label="owns", color="#000000", style="solid"] [constraint=true]; // "owns" edge
    "pueue_tui" -> "pueue_tui::cli" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "pueue_tui" -> "pueue_tui::event" [label="owns", color="#000000", style="solid"] [constraint=true]; // "owns" edge
    "pueue_tui" -> "pueue_tui::terminal" [label="owns", color="#000000", style="solid"] [constraint=true]; // "owns" edge
    "pueue_tui" -> "pueue_tui::ui" [label="owns", color="#000000", style="solid"] [constraint=true]; // "owns" edge
    "pueue_tui::app" -> "pueue_tui::cli" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "pueue_tui::app" -> "pueue_tui::event" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "pueue_tui::app" -> "pueue_tui::terminal" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "pueue_tui::terminal" -> "pueue_tui::event" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge

}
